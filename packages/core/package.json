{
  "name": "kwtsms-otp",
  "version": "0.1.0",
  "description": "SMS one-time codes (OTP) with kwtSMS: hashed codes, 3 attempts, cooldown, rate limits, country allowlist. Web APIs only.",
  "license": "MIT",
  "author": "kwtSMS (BoxLink Center)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./sender": {
      "import": { "types": "./dist/sender.d.ts", "default": "./dist/sender.js" },
      "require": { "types": "./dist/sender.d.cts", "default": "./dist/sender.cjs" }
    },
    "./libsql": {
      "import": { "types": "./dist/libsql.d.ts", "default": "./dist/libsql.js" },
      "require": { "types": "./dist/libsql.d.cts", "default": "./dist/libsql.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "sideEffects": false,
  "keywords": ["kwtsms", "sms", "otp", "one-time-code", "hono", "bun", "cloudflare-workers", "kuwait", "authentication"],
  "homepage": "https://github.com/kwtsms/kwtsms-otp#readme",
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "kwtsms": "0.6.0"
  },
  "peerDependencies": {
    "@libsql/client": ">=0.14.0"
  },
  "peerDependenciesMeta": {
    "@libsql/client": { "optional": true }
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0"
  },
  "engines": { "node": ">=18" },
  "repository": { "type": "git", "url": "git+https://github.com/kwtsms/kwtsms-otp.git", "directory": "packages/core" },
  "bugs": { "url": "https://github.com/kwtsms/kwtsms-otp/issues" }
}
