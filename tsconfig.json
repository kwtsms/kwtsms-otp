{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["packages/core/src", "packages/core/tests", "starter/src", "starter/tests", "starter/examples/express.ts", "packages/core/tsup.config.ts", "vitest.config.ts"]
}
